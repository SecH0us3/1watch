<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1117"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Interactive 24-Hour Watch Face View -->
    <com.uno24.wallpaper.Uno24ClockView
        android:id="@+id/clockView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Theme Swipe Hint & Indicator under the clock -->
    <TextView
        android:id="@+id/tvThemeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="← Смахните для смены темы: Classic Dark →"
        android:textColor="#A0A0A0"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Dropdown Spinners Row 1 (Digits filter & Size) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Цифры:"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerDisplayMode"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Размер:"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerNumeralSize"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FFFFFF" />
    </LinearLayout>

    <!-- Dropdown Spinner Row 2 (Font Selection) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Шрифт:"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerNumeralFont"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:backgroundTint="#FFFFFF" />
    </LinearLayout>

    <!-- Radial Orientation Switch under the clock -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchRadialOrientation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:checked="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Цифры повернуты к центру круга"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- Roman Numerals Switch under the clock -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchRomanNumerals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:checked="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Римские цифры (I, II, IV ... XXIV)"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- UV Toggle Switch under the clock -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchUvArc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:checked="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="УФ-активность (Open-Meteo)"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- Set Live Wallpaper Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSetWallpaper"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="4dp"
        android:text="Установить как живые обои"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:cornerRadius="12dp" />

</LinearLayout>
