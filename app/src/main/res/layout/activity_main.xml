<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14">

    <!-- Interactive Clock Area -->
    <FrameLayout
        android:id="@+id/clockContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.45"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.watch1.app.WatchClockView
            android:id="@+id/clockView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvThemeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/pill_background"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="←  Classic Dark  →"
            android:textColor="#B0B5C0"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Settings Scroll Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="100dp"
        app:layout_constraintTop_toBottomOf="@id/clockContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Category: Appearance -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/category_appearance"
                android:textColor="#FF3D00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#131722"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_dial_background"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <Spinner
                            android:id="@+id/spinnerBgMode"
                            android:layout_width="140dp"
                            android:layout_height="48dp"
                            android:backgroundTint="#8A91A4"
                            android:popupBackground="#1F2430" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickImage"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_pick_image"
                        android:textAllCaps="false"
                        android:textColor="#FF3D00"
                        android:textSize="14sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#33FF3D00" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickColor"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_pick_color"
                        android:textAllCaps="false"
                        android:textColor="#FF3D00"
                        android:textSize="14sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#33FF3D00" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1E2333"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp" />

                    <!-- Hand Shape -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_hand_style"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <Spinner
                            android:id="@+id/spinnerHandStyle"
                            android:layout_width="150dp"
                            android:layout_height="48dp"
                            android:backgroundTint="#8A91A4"
                            android:popupBackground="#1F2430" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1E2333"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp" />

                    <!-- Watch Bezel -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_bezel_style"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <Spinner
                            android:id="@+id/spinnerBezelStyle"
                            android:layout_width="160dp"
                            android:layout_height="48dp"
                            android:backgroundTint="#8A91A4"
                            android:popupBackground="#1F2430" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category: Typography -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/category_typography"
                android:textColor="#FF3D00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#131722"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Numeral Style / System -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_numeral_style"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <Spinner
                            android:id="@+id/spinnerNumeralStyle"
                            android:layout_width="160dp"
                            android:layout_height="48dp"
                            android:backgroundTint="#8A91A4"
                            android:popupBackground="#1F2430" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2333" android:layout_marginHorizontal="16dp"/>

                    <!-- Font Family -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_font"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <Spinner
                            android:id="@+id/spinnerNumeralFont"
                            android:layout_width="140dp"
                            android:layout_height="48dp"
                            android:backgroundTint="#8A91A4"
                            android:popupBackground="#1F2430" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2333" android:layout_marginHorizontal="16dp"/>

                    <!-- Display Mode -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_display_mode"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <Spinner
                            android:id="@+id/spinnerDisplayMode"
                            android:layout_width="140dp"
                            android:layout_height="48dp"
                            android:backgroundTint="#8A91A4"
                            android:popupBackground="#1F2430" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2333" android:layout_marginHorizontal="16dp"/>

                    <!-- Size Control -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_font_size"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/pill_background"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="2dp">

                            <ImageButton
                                android:id="@+id/btnSizeMinus"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="?selectableItemBackgroundBorderless"
                                android:contentDescription="Decrease size"
                                android:src="@drawable/ic_minus"
                                android:tint="#A0A0A0" />

                            <TextView
                                android:id="@+id/tvSizeValue"
                                android:layout_width="48dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="100%"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/btnSizePlus"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="?selectableItemBackgroundBorderless"
                                android:contentDescription="Increase size"
                                android:src="@drawable/ic_plus"
                                android:tint="#A0A0A0" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category: Language -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/category_language"
                android:textColor="#FF3D00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#131722"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_language"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <Spinner
                        android:id="@+id/spinnerAppLanguage"
                        android:layout_width="160dp"
                        android:layout_height="48dp"
                        android:backgroundTint="#8A91A4"
                        android:popupBackground="#1F2430" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category: Additional Settings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/category_parameters"
                android:textColor="#FF3D00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#131722"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Radial Orientation -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchRadialOrientation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/switch_radial_orientation"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:switchPadding="16dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2333" android:layout_marginHorizontal="16dp"/>

                    <!-- Day/Night Gradient -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchGradientDayNight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/switch_gradient_day_night"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:switchPadding="16dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2333" android:layout_marginHorizontal="16dp"/>

                    <!-- UV Arc -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchUvArc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/switch_uv_arc"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:switchPadding="16dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2333" android:layout_marginHorizontal="16dp"/>

                    <!-- Show Date -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchShowDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/switch_show_date"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:switchPadding="16dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2333" android:layout_marginHorizontal="16dp"/>

                    <!-- Show UV Index Badge -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchShowUvIndex"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/switch_show_uv_index"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:switchPadding="16dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2333" android:layout_marginHorizontal="16dp"/>

                    <!-- Show 1watch Brand Logo -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchShowBrandLogo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/switch_show_brand_logo"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:switchPadding="16dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2333" android:layout_marginHorizontal="16dp"/>

                    <!-- Moon Phase Indicator -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchShowMoonPhase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/switch_show_moon_phase"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:switchPadding="16dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2333" android:layout_marginHorizontal="16dp"/>

                    <!-- Golden & Blue Hours -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchShowGoldenHour"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/switch_show_golden_hour"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:switchPadding="16dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2333" android:layout_marginHorizontal="16dp"/>

                    <!-- True Solar Noon Marker -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchShowSolarNoon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/switch_show_solar_noon"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:switchPadding="16dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2333" android:layout_marginHorizontal="16dp"/>

                    <!-- Red Night Mode (Cockpit) -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchRedNightMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/switch_red_night_mode"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:switchPadding="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_gradient"
        android:padding="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddWidget"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_add_widget"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            app:strokeColor="#3A435A"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetWallpaper"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/btn_set_wallpaper"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
